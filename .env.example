# ---------------------------------------------------------------------------
# Product Launcher — environment configuration
# Copy this file to `.env` and fill in the real values. NEVER commit `.env`.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Your store's *.myshopify.com domain (NOT a custom domain).
SHOPIFY_STORE=your-store.myshopify.com

# Admin API access token from your custom app. Paste it here LOCALLY only.
# It looks like: shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# (See the README for how to create the custom app and copy this token.)
SHOPIFY_ADMIN_TOKEN=

# Admin GraphQL API version to pin. Verify mutation signatures against:
# https://shopify.dev/docs/api/admin-graphql/2025-10
SHOPIFY_API_VERSION=2025-10

# The "master" product to clone, as a GraphQL global id.
# Find the numeric id in the admin URL (.../products/1234567890) and wrap it:
MASTER_PRODUCT_ID=gid://shopify/Product/1234567890

# ---- Bundle app (extension point — see README) ----------------------------
# When false, the UI just reminds you to set the bundle up manually.
# When true, src/bundle.js applyBundle() is called after launch.
BUNDLE_AUTOMATION_ENABLED=false
# Friendly name shown in the "set up the bundle manually" reminder.
BUNDLE_APP_NAME=your bundle app

# ---- Server ---------------------------------------------------------------
PORT=3000
