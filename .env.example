# ---------------------------------------------------------------------------
# Product Launcher — environment configuration
# Copy this file to `.env` and fill in the real values. NEVER commit `.env`.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Your store's *.myshopify.com domain (NOT a custom domain).
SHOPIFY_STORE=your-store.myshopify.com

# ---- Authentication: choose ONE of the two options below ------------------
#
# OPTION A (recommended, the 2026 default) — Dev Dashboard app.
# Create an app at https://dev.shopify.com → your app → Settings: copy the
# Client ID and Client Secret. The tool exchanges these for a short-lived
# access token automatically (client credentials grant) and refreshes it.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
#
# OPTION B (legacy) — a custom app that already has a permanent token.
# Only fill this in if you have an existing shpat_ token; leave A blank then.
# (As of 2026-01-01 you can no longer create NEW legacy custom-app tokens.)
SHOPIFY_ADMIN_TOKEN=

# Admin GraphQL API version to pin. Verify mutation signatures against:
# https://shopify.dev/docs/api/admin-graphql/2025-10
SHOPIFY_API_VERSION=2025-10

# The "master" product to clone, as a GraphQL global id.
# Find the numeric id in the admin URL (.../products/1234567890) and wrap it:
MASTER_PRODUCT_ID=gid://shopify/Product/1234567890

# ---- Bundle (extension point — see README) --------------------------------
# In the "Old Glory" theme the bundle cards are NATIVE theme blocks on the
# product template, so they copy automatically with templateSuffix. The only
# manual piece is the Shopify automatic volume discount that makes the savings
# real. Leave automation OFF unless that discount is product-scoped.
BUNDLE_AUTOMATION_ENABLED=false
# Optional free-text note appended to the bundle reminder on the success card.
BUNDLE_APP_NAME=
# Only needed if you implement applyBundle() for a product-scoped discount.
# Requires the write_discounts scope on the custom app.
# AUTOMATIC_DISCOUNT_ID=gid://shopify/DiscountAutomaticNode/123456

# ---- Server ---------------------------------------------------------------
PORT=3000
